{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mysteryboard.invalid/schemas/document-v3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "MysteryBoard"
        },
        "formatVersion": {
          "const": 3
        },
        "kind": {
          "const": "task"
        },
        "content": {
          "$ref": "https://mysteryboard.invalid/schemas/content-v3"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["format", "formatVersion", "kind", "content", "contentHash"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "MysteryBoard"
        },
        "formatVersion": {
          "const": 3
        },
        "kind": {
          "const": "draft"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
            },
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            "subtitle": {
              "type": "string",
              "minLength": 0,
              "maxLength": 300
            },
            "cards": {
              "type": "array",
              "minItems": 0,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "title": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 100
                  },
                  "text": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4000
                  },
                  "group": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "image": {
                    "type": "string",
                    "maxLength": 4000100,
                    "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
                  },
                  "imageAlt": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 300
                  },
                  "source": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 1000
                  },
                  "table": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "caption": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "headers": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "rows": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 20,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "string",
                            "maxLength": 120
                          }
                        }
                      }
                    },
                    "required": ["headers", "rows"]
                  }
                },
                "required": ["id", "title", "text", "group"]
              }
            },
            "cardGroups": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 100,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "prefix": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 3
                  }
                },
                "required": ["label", "prefix"]
              }
            },
            "startLayout": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "ordered"
                    },
                    "columns": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    }
                  },
                  "required": ["mode"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "explicit"
                    }
                  },
                  "required": ["mode"]
                }
              ]
            },
            "initial": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cards": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "x": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "color": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "required": ["id", "x", "y", "color"]
                  }
                },
                "edges": {
                  "type": "array",
                  "maxItems": 0
                },
                "categories": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "const": ""
                  }
                }
              },
              "required": ["cards", "edges", "categories"]
            },
            "help": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "categories": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "cardIds": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "uniqueItems": true,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000
                        }
                      }
                    },
                    "required": ["id", "label", "color", "cardIds"]
                  }
                }
              },
              "required": []
            }
          },
          "required": ["id", "version", "title", "cards", "cardGroups"],
          "$comment": "Zusätzlich gilt der gemeinsame semantische Validator src/core/documents.ts: eindeutige fortlaufende IDs, Gruppen-/Hilfereferenzen, neutrale Startdaten, Medienformat/Abmessungen/Summenlimits. npm run validate:mystery prüft Struktur UND diese in JSON Schema nicht ausdrückbaren Querverweise."
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "status": {
              "enum": ["in-progress", "reviewed"]
            },
            "hiddenCards": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "required": ["initials", "status", "hiddenCards"]
        }
      },
      "required": [
        "format",
        "formatVersion",
        "kind",
        "content",
        "contentHash",
        "author"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "MysteryBoard"
        },
        "formatVersion": {
          "const": 3
        },
        "kind": {
          "const": "student"
        },
        "content": {
          "$ref": "https://mysteryboard.invalid/schemas/content-v3"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "enum": [1, 2]
            },
            "mystery": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  }
                },
                "required": ["id", "x", "y", "color"]
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "from": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "direction": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "label": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 500
                  }
                },
                "required": ["id", "from", "to", "direction", "label"]
              }
            },
            "categories": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 40
              }
            },
            "team": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "schema",
            "mystery",
            "version",
            "cards",
            "edges",
            "categories"
          ]
        }
      },
      "required": [
        "format",
        "formatVersion",
        "kind",
        "content",
        "contentHash",
        "work"
      ]
    }
  ],
  "$comment": "contentHash = SHA-256 des kanonisch normalisierten vollständigen Inhalts. Schüler-Work wird zusätzlich gegen Inhalt geprüft. Grenzen und Medienprüfung: gemeinsamer Validator."
}
