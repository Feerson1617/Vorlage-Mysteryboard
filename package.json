{
  "name": "mysteryboard-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --tests && playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "build:review": "node scripts/build.mjs review",
    "build:example": "node scripts/build.mjs reuse-example",
    "release:rc2": "npm run build && node scripts/prepare-rc2.mjs && python scripts/validate-scorm.py artifacts/MysteryBoard-Boden-Klasse11-RC2-SCORM-1.2.zip artifacts/MysteryBoard-Boden-Klasse11-RC2.html",
    "test:rc2": "playwright test --config playwright.rc2.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
